# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 公開URL（例: https://oshi-calendar.vercel.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 定期実行（Vercel Cron）の合言葉。Vercelの CRON_SECRET と同じ値
CRON_SECRET=

# 告知文の読み取り・ニュースの分類（Claude API）。未設定ならキーワードでの簡易判定
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# プッシュ通知（npx web-push generate-vapid-keys で作成）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# メール通知（Resend）
RESEND_API_KEY=
MAIL_FROM=推し活カレンダー <noreply@example.com>

# LINE通知（LINE Messaging API）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# 会員メールの取り込み（転送先ドメインと受信Webhookの合言葉）
INBOUND_MAIL_DOMAIN=in.example.com
INBOUND_MAIL_SECRET=
